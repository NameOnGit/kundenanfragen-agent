<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Kundenanfragen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="handgeschrieben" exporterVersion="1.1">
<bpmn:collaboration id="Collab_Kundenanfragen">
<bpmn:documentation>Kundenanfragen-Agent, Version 1.1 (16.10.2026). KI sortiert eingehende Kundenmails und legt Antwortentwürfe an; ein Mensch prüft und versendet.</bpmn:documentation>
<bpmn:participant id="Pool_Kunde" name="Kunde (Autohaus / Werkstatt)" />
<bpmn:participant id="Pool_KI" name="KI-Agent (n8n + Claude)" processRef="Process_KI" />
<bpmn:participant id="Pool_Mitarbeiter" name="Kundenservice-Mitarbeiter" processRef="Process_Mitarbeiter" />
<bpmn:messageFlow id="Msg_Anfrage" name="Anfrage als Mail" sourceRef="Pool_Kunde" targetRef="Start_NeueMail" />
<bpmn:messageFlow id="Msg_Warnung" name="Telegram-Nachricht" sourceRef="T_Telegram" targetRef="M_StartWarnung" />
<bpmn:messageFlow id="Msg_Antwort" name="Antwort-Mail" sourceRef="M_Senden" targetRef="Pool_Kunde" />
</bpmn:collaboration>
<bpmn:process id="Process_KI" name="Kundenanfragen-Agent" isExecutable="false"><bpmn:startEvent id="Start_NeueMail" name="Neue Kundenmail im Postfach"><bpmn:documentation>n8n: Gmail Trigger „Neue Mail“, prüft jede Minute auf ungelesene Mails.</bpmn:documentation><bpmn:outgoing>Flow_m1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_start" /></bpmn:startEvent><bpmn:endEvent id="End_AlleMails" name="Alle neuen Mails verarbeitet"><bpmn:incoming>Flow_m2</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_m1" sourceRef="Start_NeueMail" targetRef="Sub_JedeMail" /><bpmn:sequenceFlow id="Flow_m2" sourceRef="Sub_JedeMail" targetRef="End_AlleMails" /><bpmn:subProcess id="Sub_JedeMail" name="Jede Mail einzeln verarbeiten"><bpmn:documentation>n8n: Loop Over Items „Mails einzeln verarbeiten“ (Batch Size 1). Seit Version 1.1.</bpmn:documentation><bpmn:incoming>Flow_m1</bpmn:incoming><bpmn:outgoing>Flow_m2</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics id="MI_JedeMail" isSequential="true" /><bpmn:startEvent id="Sub_Start" name=""><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="T_MailDaten" name="Mail-Daten übernehmen"><bpmn:documentation>n8n: Edit Fields „Mail-Daten“. Übernimmt Absender, Betreff und Text der Mail.</bpmn:documentation><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task><bpmn:serviceTask id="T_Verstehen" name="E-Mail verstehen (Kategorie + Daten)"><bpmn:documentation>n8n: Basic LLM Chain „E-Mail verstehen“ mit Claude Haiku und Structured Output Parser. Liefert Kategorie, Kunde, Ansprechpartner, Bestellnummer, Artikel, Menge, Zusammenfassung.</bpmn:documentation><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="GW_Kategorie" name="Kategorie?"><bpmn:documentation>n8n: Switch „Switch nach Kategorie“ mit vier benannten Ausgängen.</bpmn:documentation><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F_Lief</bpmn:outgoing><bpmn:outgoing>F_Ang</bpmn:outgoing><bpmn:outgoing>F_Sons</bpmn:outgoing><bpmn:outgoing>F_Rek</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T_Lieferstatus" name="Bestellung nachschlagen und Antwort schreiben"><bpmn:documentation>n8n: AI Agent „Agent Lieferstatus“ mit Werkzeug „Bestellungen“ (Google Sheets, Get Rows). Erfindet keinen Status; fragt nach der Bestellnummer, wenn sie fehlt.</bpmn:documentation><bpmn:incoming>F_Lief</bpmn:incoming><bpmn:outgoing>F_Lief2</bpmn:outgoing><bpmn:property id="Prop_Lief" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DIA_Bestellungen"><bpmn:sourceRef>DS_Bestellungen</bpmn:sourceRef><bpmn:targetRef>Prop_Lief</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask><bpmn:dataStoreReference id="DS_Bestellungen" name="Bestellungen (Google Sheet)" /><bpmn:serviceTask id="T_Angebot" name="Anfrage bestätigen"><bpmn:documentation>n8n: Basic LLM Chain „Antwort Angebotsanfrage“. Nennt keine Preise, Rabatte oder Lieferzeiten.</bpmn:documentation><bpmn:incoming>F_Ang</bpmn:incoming><bpmn:outgoing>F_Ang2</bpmn:outgoing></bpmn:serviceTask><bpmn:task id="T_Sonstiges" name="Standardantwort einsetzen (ohne KI)"><bpmn:documentation>n8n: Edit Fields „Antwort Sonstiges“. Fester Textbaustein, Anrede per Ausdruck.</bpmn:documentation><bpmn:incoming>F_Sons</bpmn:incoming><bpmn:outgoing>F_Sons2</bpmn:outgoing></bpmn:task><bpmn:parallelGateway id="PG_Split"><bpmn:incoming>F_Rek</bpmn:incoming><bpmn:outgoing>F_R1</bpmn:outgoing><bpmn:outgoing>F_R2</bpmn:outgoing></bpmn:parallelGateway><bpmn:serviceTask id="T_Entschuldigung" name="Entschuldigung schreiben"><bpmn:documentation>n8n: Basic LLM Chain „Antwort Reklamation“. Entschuldigt sich, verspricht keinen Ersatz, keine Gutschrift und keine Termine.</bpmn:documentation><bpmn:incoming>F_R1</bpmn:incoming><bpmn:outgoing>F_R1b</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="T_Telegram" name="Warnung an Kundenservice senden"><bpmn:documentation>n8n: Telegram „Warnung Reklamation“ mit Kunde, Ansprechpartner, Bestellnummer und Zusammenfassung.</bpmn:documentation><bpmn:incoming>F_R2</bpmn:incoming><bpmn:outgoing>F_R2b</bpmn:outgoing></bpmn:sendTask><bpmn:parallelGateway id="PG_Join"><bpmn:incoming>F_R1b</bpmn:incoming><bpmn:incoming>F_R2b</bpmn:incoming><bpmn:outgoing>F_Rj</bpmn:outgoing></bpmn:parallelGateway><bpmn:exclusiveGateway id="GW_Merge"><bpmn:incoming>F_Lief2</bpmn:incoming><bpmn:incoming>F_Ang2</bpmn:incoming><bpmn:incoming>F_Sons2</bpmn:incoming><bpmn:incoming>F_Rj</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="T_Vorbereiten" name="Antwort vorbereiten (Empfänger, Re: Betreff)"><bpmn:documentation>n8n: Edit Fields „Antwort vorbereiten“. Vereinheitlicht die Antwort aller Zweige und holt Empfänger und Betreff aus „Mail-Daten“.</bpmn:documentation><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task><bpmn:serviceTask id="T_Entwurf" name="Gmail-Entwurf anlegen"><bpmn:documentation>n8n: Gmail-Baustein „Gmail-Entwurf anlegen“ (Draft → Create). Legt nur einen Entwurf an, versendet nichts.</bpmn:documentation><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_Entwuerfe"><bpmn:targetRef>DS_Entwuerfe</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:endEvent id="Sub_End" name="Entwurf liegt bereit"><bpmn:incoming>F6</bpmn:incoming></bpmn:endEvent><bpmn:textAnnotation id="Legende"><bpmn:text>Legende
Lila = Schritt mit KI (Claude Haiku)
Grün = Schritt durch einen Menschen
Weiß = feste Regel, ohne KI
Die KI legt nur Entwürfe an, sie versendet nichts.</bpmn:text></bpmn:textAnnotation><bpmn:sequenceFlow id="F1" sourceRef="Sub_Start" targetRef="T_MailDaten" /><bpmn:sequenceFlow id="F2" sourceRef="T_MailDaten" targetRef="T_Verstehen" /><bpmn:sequenceFlow id="F3" sourceRef="T_Verstehen" targetRef="GW_Kategorie" /><bpmn:sequenceFlow id="F_Lief" name="Lieferstatus" sourceRef="GW_Kategorie" targetRef="T_Lieferstatus" /><bpmn:sequenceFlow id="F_Ang" name="Angebotsanfrage" sourceRef="GW_Kategorie" targetRef="T_Angebot" /><bpmn:sequenceFlow id="F_Sons" name="Sonstiges" sourceRef="GW_Kategorie" targetRef="T_Sonstiges" /><bpmn:sequenceFlow id="F_Rek" name="Reklamation" sourceRef="GW_Kategorie" targetRef="PG_Split" /><bpmn:sequenceFlow id="F_R1" sourceRef="PG_Split" targetRef="T_Entschuldigung" /><bpmn:sequenceFlow id="F_R2" sourceRef="PG_Split" targetRef="T_Telegram" /><bpmn:sequenceFlow id="F_R1b" sourceRef="T_Entschuldigung" targetRef="PG_Join" /><bpmn:sequenceFlow id="F_R2b" sourceRef="T_Telegram" targetRef="PG_Join" /><bpmn:sequenceFlow id="F_Lief2" sourceRef="T_Lieferstatus" targetRef="GW_Merge" /><bpmn:sequenceFlow id="F_Ang2" sourceRef="T_Angebot" targetRef="GW_Merge" /><bpmn:sequenceFlow id="F_Sons2" sourceRef="T_Sonstiges" targetRef="GW_Merge" /><bpmn:sequenceFlow id="F_Rj" sourceRef="PG_Join" targetRef="GW_Merge" /><bpmn:sequenceFlow id="F4" sourceRef="GW_Merge" targetRef="T_Vorbereiten" /><bpmn:sequenceFlow id="F5" sourceRef="T_Vorbereiten" targetRef="T_Entwurf" /><bpmn:sequenceFlow id="F6" sourceRef="T_Entwurf" targetRef="Sub_End" /></bpmn:subProcess><bpmn:dataStoreReference id="DS_Entwuerfe" name="Gmail-Entwürfe" /></bpmn:process>
<bpmn:process id="Process_Mitarbeiter" name="Kundenservice" isExecutable="false"><bpmn:startEvent id="M_StartWarnung" name="Warnung erhalten"><bpmn:outgoing>MF1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_warn" /></bpmn:startEvent><bpmn:userTask id="M_Klaeren" name="Reklamation intern klären"><bpmn:incoming>MF1</bpmn:incoming><bpmn:outgoing>MF2</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="M_EndKlaeren" name="Reklamation in Bearbeitung"><bpmn:incoming>MF2</bpmn:incoming></bpmn:endEvent><bpmn:startEvent id="M_StartEntwurf" name="Neuer Entwurf in Gmail"><bpmn:outgoing>MF3</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="M_Pruefen" name="Entwurf prüfen und anpassen"><bpmn:documentation>Mensch bleibt in der Schleife: nichts wird automatisch versendet.</bpmn:documentation><bpmn:incoming>MF3</bpmn:incoming><bpmn:outgoing>MF4</bpmn:outgoing><bpmn:property id="Prop_Pruefen" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DIA_Entwuerfe"><bpmn:sourceRef>DS_Entwuerfe</bpmn:sourceRef><bpmn:targetRef>Prop_Pruefen</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask><bpmn:sendTask id="M_Senden" name="Antwort an Kunden senden"><bpmn:incoming>MF4</bpmn:incoming><bpmn:outgoing>MF5</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="M_End" name="Antwort versendet"><bpmn:incoming>MF5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="MF1" sourceRef="M_StartWarnung" targetRef="M_Klaeren" /><bpmn:sequenceFlow id="MF2" sourceRef="M_Klaeren" targetRef="M_EndKlaeren" /><bpmn:sequenceFlow id="MF3" sourceRef="M_StartEntwurf" targetRef="M_Pruefen" /><bpmn:sequenceFlow id="MF4" sourceRef="M_Pruefen" targetRef="M_Senden" /><bpmn:sequenceFlow id="MF5" sourceRef="M_Senden" targetRef="M_End" /></bpmn:process>
